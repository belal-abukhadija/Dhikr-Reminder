{
  "manifest_version": 3,
  "name": "The Reminder",
  "version": "1.1",
  "description": "A beautiful, minimalist dhikr reminder for your daily routine.",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "The Reminder",
    "default_icon": "icon-48.png"
  },
  "options_page": "options.html",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
